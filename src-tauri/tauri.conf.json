{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incremental Reading",
  "version": "0.0.1",
  "identifier": "dev.local.incremental-reading",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Incremental Reading",
        "width": 1200,
        "height": 820,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}